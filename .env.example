# Convex Configuration
# For self-hosted Convex deployment
VITE_CONVEX_URL=https://your-convex-backend.yourdomain.com
CONVEX_SELF_HOSTED_URL=https://your-convex-backend.yourdomain.com
CONVEX_SELF_HOSTED_ADMIN_KEY=self-hosted-convex|your_admin_key_here

# For cloud-hosted Convex (alternative to self-hosted)
# CONVEX_DEPLOYMENT=your_convex_deployment_name
# VITE_CONVEX_URL=https://your_deployment.convex.cloud

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
VITE_CLERK_FRONTEND_API_URL=https://clerk.yourdomain.com
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key

# Application URLs
FRONTEND_URL=https://yourdomain.com

# OpenAI API (for AI chat features)
OPENAI_API_KEY=sk-proj-your_openai_api_key

# Polar.sh Payment & Subscription Management
POLAR_SERVER=production
POLAR_ACCESS_TOKEN=polar_oat_your_polar_access_token
POLAR_ORGANIZATION_ID=your_polar_organization_id
POLAR_WEBHOOK_SECRET=polar_whs_your_polar_webhook_secret
